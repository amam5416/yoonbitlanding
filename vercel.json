{
  "redirects": [
    { "source": "/attorneys/:slug", "destination": "/attr/:slug", "permanent": true },
    { "source": "/recovery/:slug", "destination": "/rcvlist/:slug", "permanent": true },
    { "source": "/attorneys", "destination": "/#attr", "permanent": true },
    { "source": "/attr", "destination": "/#attr", "permanent": true },
    { "source": "/rcvlist", "destination": "/#cases", "permanent": true },
    { "source": "/recovery", "destination": "/#cases", "permanent": true },
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/sitemap.xml", "destination": "/sitemap-index.xml", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|webp|mp4|ico|svg)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    }
  ]
}
