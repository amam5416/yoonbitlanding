---
import '@/styles/global.css';
import { SITE } from '@/site.config';
import { attorneys } from '@/data/attorneys';
import { personSchema } from '@/data/schema';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article' | 'profile';
  /** og:image 경로 (기본 /og.jpg) */
  ogImage?: string;
  ogImageAlt?: string;
  /** 페이지별 추가 JSON-LD */
  schema?: object | object[];
  /** canonical 재정의 (기본: 현재 경로) */
  canonical?: string;
  /** 검색 노출 제외 */
  noindex?: boolean;
  /** 페이지네이션 */
  prev?: string;
  next?: string;
  /** type="article" 일 때 article:published_time / modified_time (YYYY-MM-DD) */
  publishedTime?: string;
  modifiedTime?: string;
}
/** 검색·SNS 미리보기 대표 이미지 (네이버·구글 og:image, JSON-LD image). 교체 시 public/ 파일과 크기를 함께 갱신 */
const DEFAULT_OG = { path: '/nog.jpg', width: 949, height: 1280, alt: `${SITE.firm.name} 피해금 회수 결과 안내서 — 전액 회복` };
const {
  title = SITE.title,
  description = SITE.description,
  type = 'website',
  ogImage: ogPath = DEFAULT_OG.path,
  ogImageAlt = DEFAULT_OG.alt,
  schema,
  canonical: canonicalProp,
  noindex = false,
  prev,
  next,
  publishedTime,
  modifiedTime,
} = Astro.props;
const siteUrl = SITE.url;
const canonicalUrl =
  canonicalProp ?? (Astro.url.pathname === '/' ? `${siteUrl}/` : new URL(Astro.url.pathname, siteUrl).toString().replace(/\/$/, ''));
const ogImage = `${siteUrl}${ogPath}`;

const siteSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['LegalService', 'LocalBusiness'],
      '@id': `${siteUrl}/#legalservice`,
      name: SITE.name,
      alternateName: 'Yoonbit Financial Fraud Task Force',
      description: SITE.description,
      url: `${siteUrl}/`,
      image: ogImage,
      logo: `${siteUrl}/logo.png`,
      telephone: SITE.phoneIntl,
      priceRange: '초기 상담 무료',
      areaServed: { '@type': 'Country', name: 'KR' },
      address: {
        '@type': 'PostalAddress',
        streetAddress: '영동대로 621, 621빌딩 11층',
        addressLocality: '강남구',
        addressRegion: '서울특별시',
        addressCountry: 'KR',
      },
      geo: { '@type': 'GeoCoordinates', latitude: SITE.offices[0].geo.lat, longitude: SITE.offices[0].geo.lng },
      openingHoursSpecification: {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
        opens: '00:00',
        closes: '23:59',
      },
      knowsAbout: ['투자사기', '사칭사기', '리딩방 사기', '피해금 회수', '계좌 동결', '가압류', '집단소송', '보이스피싱'],
      serviceType: ['사기 피해금 추적', '계좌 동결·긴급 가압류', '형사고소 대리', '민사소송', '집단 공동고소'],
      ...(SITE.firm.sameAs.length ? { sameAs: SITE.firm.sameAs } : {}),
      // 변호사는 이 사업체(전담본부) 소속으로 모델링 — Person.worksFor 와 방향을 맞춘다. Person 노드는 아래 공통 그래프에 포함
      employee: attorneys.map((a) => ({ '@id': `${siteUrl}/attr/${a.slug}#person` })),
      subOrganization: { '@id': `${siteUrl}/#andong` },
      parentOrganization: {
        '@type': 'Organization',
        '@id': `${siteUrl}/#lawfirm`,
        name: SITE.firm.name,
        legalName: SITE.firm.name,
        taxID: SITE.firm.registration,
      },
    },
    {
      // 안동 분사무소 (화면의 오시는 길과 동일하게 두 사무소를 모두 노출)
      '@type': ['LegalService', 'LocalBusiness'],
      '@id': `${siteUrl}/#andong`,
      name: `${SITE.firm.name} 안동 분사무소`,
      url: `${siteUrl}/#location`,
      image: ogImage,
      telephone: SITE.phoneIntl,
      address: {
        '@type': 'PostalAddress',
        streetAddress: '강남5길 20-26, 2층 201호',
        addressLocality: '안동시',
        addressRegion: '경상북도',
        addressCountry: 'KR',
      },
      parentOrganization: { '@id': `${siteUrl}/#legalservice` },
    },
    // 변호사 3명 — 모든 페이지에 동일하게 정의해 employee/reviewedBy/author 참조가 어디서나 해소되도록
    ...attorneys.map(personSchema),
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      name: SITE.name,
      url: `${siteUrl}/`,
      inLanguage: 'ko-KR',
      publisher: { '@id': `${siteUrl}/#legalservice` },
      potentialAction: {
        '@type': 'SearchAction',
        target: { '@type': 'EntryPoint', urlTemplate: `${siteUrl}/?q={search_term_string}` },
        'query-input': 'required name=search_term_string',
      },
    },
  ],
};
const schemas = [siteSchema, ...(schema ? (Array.isArray(schema) ? schema : [schema]) : [])];
---
<!doctype html>
<html lang="ko" class="bg-background">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="preload" as="image" href="/logo.png" />
  <link rel="icon" href="/favicon.ico" sizes="256x256" type="image/x-icon" />
  <meta name="generator" content={Astro.generator} />
  <!-- 스크롤 등장 애니메이션용: JS 가 켜진 환경에서만 숨김 스타일 활성화 (첫 페인트 전에 실행) -->
  <script is:inline>document.documentElement.classList.add('reveal-ready')</script>
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1'} />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="alternate" hreflang="ko" href={canonicalUrl} />
  <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
  {prev && <link rel="prev" href={prev} />}
  {next && <link rel="next" href={next} />}
  <meta name="author" content={SITE.firm.name} />
  <meta property="og:type" content={type} />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={ogImage} />
  {ogPath === DEFAULT_OG.path && <meta property="og:image:width" content={String(DEFAULT_OG.width)} />}
  {ogPath === DEFAULT_OG.path && <meta property="og:image:height" content={String(DEFAULT_OG.height)} />}
  {ogPath === DEFAULT_OG.path && <meta property="og:image:type" content="image/jpeg" />}
  <meta property="og:image:alt" content={ogImageAlt} />
  <meta property="og:locale" content="ko_KR" />
  {type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
  {type === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
  {type === 'article' && <meta property="article:author" content={SITE.firm.name} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
  {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  <slot name="head" />
</head>
<body class="font-sans antialiased pb-[68px] md:pb-[56px]">
  <slot />
</body>
</html>
