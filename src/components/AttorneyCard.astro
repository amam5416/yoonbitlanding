---
import Icons from './Icons.astro';
import { SITE } from '@/site.config';
interface Props { slug: string; name: string; role: string; img: string; highlights?: string[] }
const { slug, name, role, img, highlights = [] } = Astro.props;
---
<a class="group flex h-full flex-col overflow-hidden rounded-xl card-lux outline-none transition-all duration-300 hover:-translate-y-1 hover:shadow-lg focus-visible:ring-2 focus-visible:ring-ring" aria-label={`${name} ${role} 상세 소개`} href={`/attr/${slug}`}>
  <div class="aspect-[4/5] overflow-hidden bg-photo">
    <img src={img} alt={`${SITE.firm.name} ${name} ${role}`} width="480" height="600" loading="lazy" class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]" />
  </div>
  <div class="flex flex-1 flex-col p-4 sm:p-5">
    <div class="flex items-baseline gap-2">
      <p class="text-lg font-bold text-foreground group-hover:text-primary">{name}</p>
      <p class="text-sm font-medium text-muted-foreground">{role}</p>
    </div>
    {highlights.length > 0 && (
      <ul class="mt-3 space-y-1.5">
        {highlights.map((h) => (
          <li class="flex items-start gap-2 text-sm leading-snug text-foreground/85">
            <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-primary/60" aria-hidden="true"></span>{h}
          </li>
        ))}
      </ul>
    )}
    <span class="mt-auto inline-flex items-center gap-1 pt-4 text-sm font-semibold text-primary">프로필 보기<Icons name="chevron-right" class="h-4 w-4" /></span>
  </div>
</a>
