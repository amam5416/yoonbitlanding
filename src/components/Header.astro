---
import { SITE } from '@/site.config';
---
<header class="sticky top-0 z-40 hairline-gold glass-strong">
  <div class="mx-auto flex h-16 w-full max-w-6xl items-center justify-between px-4 sm:px-6">
    <a class="flex items-center gap-2.5" aria-label={`${SITE.name} 홈`} href="/">
      <img src="/logo.png" alt={`${SITE.name} 로고`} class="h-9 w-auto shrink-0" />
      <div class="flex flex-col leading-tight">
        <span class="text-base font-bold tracking-tight text-foreground">{SITE.name}</span>
        <span class="text-xs text-muted-foreground">{SITE.tagline}</span>
      </div>
    </a>
    <nav class="flex items-center gap-2 sm:gap-5">
      <a href="#cases" class="hidden text-sm font-medium text-muted-foreground transition-colors hover:text-foreground sm:inline-flex">사칭 목록</a>
      <a href={SITE.phoneHref} class="inline-flex h-8 shrink-0 items-center justify-center gap-1.5 rounded-lg btn-gold px-2.5 text-sm font-semibold whitespace-nowrap transition-all">긴급 상담</a>
    </nav>
  </div>
</header>
