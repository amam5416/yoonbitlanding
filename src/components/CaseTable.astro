---
/**
 * 진행 중인 사건 목록 — 서버 렌더 + 정적 페이지네이션 (/page/N).
 * 열: 사건명 / 상태 / 등록 / 바로가기. 행 전체가 링크처럼 동작.
 */
import Icons from './Icons.astro';
import { SITE } from '@/site.config';
import { casesForPage, totalPages, pageHref, caseHref, TOTAL_CASES, PER_PAGE } from '@/data/cases';

interface Props { page: number }
const { page } = Astro.props;
const rows = casesForPage(page);
const today = new Date(SITE.updatedAt);

/** 등록일을 "오늘 / 어제 / N일 전 / 날짜"로 */
function relative(date: string) {
  const d = new Date(date);
  const diff = Math.round((today.getTime() - d.getTime()) / 86400000);
  if (diff <= 0) return '오늘';
  if (diff === 1) return '어제';
  if (diff < 7) return `${diff}일 전`;
  return date;
}

const pages: (number | '…')[] = [];
for (let i = 1; i <= totalPages; i++) {
  if (i === 1 || i === totalPages || Math.abs(i - page) <= 1) pages.push(i);
  else if (pages[pages.length - 1] !== '…') pages.push('…');
}
const start = (page - 1) * PER_PAGE + 1;
const end = start + rows.length - 1;
---
<section id="cases" class="marble-section-strong" data-marble="2" aria-labelledby="cases-title">
  <div class="mx-auto w-full max-w-6xl scroll-mt-20 px-4 py-10 sm:px-6">
  <div data-reveal="0" class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h2 id="cases-title" class="text-xl font-bold tracking-tight text-foreground sm:text-2xl">지금 접수된 정상기업 사칭 사건</h2>
      <p class="mt-1 text-sm text-muted-foreground">내가 투자한 곳이 정상 기업인지 확인해 보세요. 목록에 있다면 이미 피해 신고가 접수된 곳입니다.</p>
    </div>
    <div class="flex items-center gap-3 text-xs text-muted-foreground">
      <span class="inline-flex items-center gap-1.5 rounded-md bg-destructive/10 px-2.5 py-1 font-semibold text-destructive">
        <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-destructive" aria-hidden="true"></span>실시간 접수 중
      </span>
      <span>전체 {TOTAL_CASES.toLocaleString()}건 중 {start}–{end}</span>
    </div>
  </div>

  <div data-reveal="80" class="overflow-hidden rounded-lg card-lux">
    <table class="w-full border-collapse text-left text-sm">
      <caption class="sr-only">{SITE.name} 사칭 목록 {page}페이지</caption>
      <thead class="hidden sm:table-header-group">
        <tr class="border-b border-border bg-secondary/60 text-xs text-muted-foreground">
          <th scope="col" class="py-2.5 pl-4 pr-2 font-semibold">사건명</th>
          <th scope="col" class="w-28 px-2 py-2.5 font-semibold">상태</th>
          <th scope="col" class="w-28 px-2 py-2.5 font-semibold">등록</th>
          <th scope="col" class="w-28 py-2.5 pl-2 pr-4 text-right font-semibold"><span class="sr-only">상세</span></th>
        </tr>
      </thead>
      <tbody>
        {rows.map((c, i) => {
          const rel = relative(c.date);
          const isNew = rel === '오늘';
          return (
            <tr data-reveal={120 + i * 30} class="group cursor-pointer border-b border-border transition-colors last:border-0 hover:bg-primary/[0.04]" data-href={caseHref(c.slug)}>
              <td class="py-3 pl-4 pr-2 sm:py-3.5">
                <a href={caseHref(c.slug)} class="flex min-w-0 items-center gap-2 font-semibold text-foreground group-hover:text-primary">
                  <span class="min-w-0 truncate">{c.name}</span>
                  <span class="hidden shrink-0 text-xs font-normal text-muted-foreground sm:inline">사칭 사기</span>
                  {isNew && <span class="shrink-0 rounded bg-destructive px-1.5 py-0.5 text-[10px] font-bold uppercase leading-none text-on-dark">New</span>}
                </a>
                <div class="mt-1 flex items-center gap-2 text-xs text-muted-foreground sm:hidden">
                  <span class="inline-flex items-center gap-1 font-medium text-foreground/80"><span class="h-1.5 w-1.5 rounded-full bg-success-soft" aria-hidden="true"></span>진행 중</span>
                  <span aria-hidden="true">·</span>
                  <time datetime={c.date}>{rel}</time>
                </div>
              </td>
              <td class="hidden px-2 py-3.5 sm:table-cell">
                <span class="inline-flex items-center gap-1.5 whitespace-nowrap rounded-md border border-success-soft/20 bg-success-soft/10 px-2.5 py-1 text-xs font-semibold text-success">
                  <span class="h-1.5 w-1.5 rounded-full bg-success-soft" aria-hidden="true"></span>진행 중
                </span>
              </td>
              <td class="hidden whitespace-nowrap px-2 py-3.5 text-xs text-muted-foreground sm:table-cell"><time datetime={c.date} title={c.date}>{rel}</time></td>
              <td class="py-3 pl-2 pr-4 text-right sm:py-3.5">
                <span class="inline-flex items-center gap-1 text-xs font-semibold text-primary sm:opacity-0 sm:transition-opacity sm:group-hover:opacity-100">
                  <span class="hidden sm:inline">사건 보기</span><Icons name="chevron-right" class="h-4 w-4" />
                </span>
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>

  {totalPages > 1 && (
    <nav class="mt-6 flex flex-wrap items-center justify-center gap-1.5" aria-label="사칭 목록 페이지네이션">
      {page > 1 ? (
        <a href={`${pageHref(page - 1)}#cases`} rel="prev" class="inline-flex h-9 items-center gap-1 rounded-md card-lux px-3 text-sm font-medium text-foreground transition-colors hover:border-primary hover:text-primary"><Icons name="chevron-left" class="h-4 w-4" />이전</a>
      ) : (
        <span aria-disabled="true" class="inline-flex h-9 items-center gap-1 rounded-md border border-border px-3 text-sm text-muted-foreground opacity-40"><Icons name="chevron-left" class="h-4 w-4" />이전</span>
      )}
      {pages.map((p) =>
        p === '…' ? (
          <span class="px-1 text-sm text-muted-foreground" aria-hidden="true">…</span>
        ) : (
          <a href={`${pageHref(p)}#cases`} aria-current={p === page ? 'page' : undefined} class:list={['inline-flex h-9 min-w-9 items-center justify-center rounded-md px-2.5 text-sm transition-colors', p === page ? 'btn-gold font-bold' : 'card-lux text-foreground hover:border-primary hover:text-primary']}>{p}</a>
        ),
      )}
      {page < totalPages ? (
        <a href={`${pageHref(page + 1)}#cases`} rel="next" class="inline-flex h-9 items-center gap-1 rounded-md card-lux px-3 text-sm font-medium text-foreground transition-colors hover:border-primary hover:text-primary">다음<Icons name="chevron-right" class="h-4 w-4" /></a>
      ) : (
        <span aria-disabled="true" class="inline-flex h-9 items-center gap-1 rounded-md border border-border px-3 text-sm text-muted-foreground opacity-40">다음<Icons name="chevron-right" class="h-4 w-4" /></span>
      )}
    </nav>
  )}

  <div data-reveal="0" class="mt-6 flex flex-col items-center justify-between gap-3 rounded-lg border border-dashed border-border bg-secondary/40 px-4 py-4 text-sm sm:flex-row">
    <p class="text-muted-foreground">목록에 없나요? 리딩방은 이름을 자주 바꿉니다. 같은 조직인지 확인해 드립니다.</p>
    <a href={SITE.phoneHref} class="inline-flex h-10 shrink-0 items-center gap-1.5 rounded-md btn-gold px-4 text-sm font-bold"><Icons name="phone" class="h-4 w-4" />전화로 바로 접수</a>
  </div>
  </div>
</section>

<script>
  // 행 어디를 눌러도 사건 상세로 이동 (링크·버튼 클릭은 기본 동작 유지)
  document.querySelectorAll<HTMLTableRowElement>('#cases tr[data-href]').forEach((tr) => {
    tr.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a, button')) return;
      location.href = tr.dataset.href!;
    });
  });
</script>
