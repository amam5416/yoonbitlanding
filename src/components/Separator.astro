---
const label = 'LAW FIRM YOONBIT';
---
<div class="border-y border-primary/15 bg-primary/10" role="separator" aria-label={label}>
  <div class="mx-auto flex w-full max-w-6xl items-center justify-center gap-4 px-4 py-1 sm:gap-6 sm:px-6">
    <span aria-hidden="true" class="hidden h-px w-12 gold-line sm:block sm:w-16"></span>
    <span class="whitespace-nowrap text-center text-xs font-medium uppercase tracking-[0.35em] text-gold sm:text-sm sm:tracking-[0.4em]">{label}</span>
    <span aria-hidden="true" class="hidden h-px w-12 gold-line sm:block sm:w-16"></span>
  </div>
</div>
