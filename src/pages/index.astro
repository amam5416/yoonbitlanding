---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Hero from '@/components/Hero.astro';
import Separator from '@/components/Separator.astro';
import CaseTable from '@/components/CaseTable.astro';
import HomeGuide from '@/components/HomeGuide.astro';
import Attorneys from '@/components/Attorneys.astro';
import Location from '@/components/Location.astro';
import Footer from '@/components/Footer.astro';
import BottomBar from '@/components/BottomBar.astro';
import Reveal from '@/components/Reveal.astro';
import { homeSchema } from '@/data/schema';
import { totalPages, pageHref } from '@/data/cases';
---
<BaseLayout schema={homeSchema(1)} next={totalPages > 1 ? pageHref(2) : undefined}>
  <div class="flex min-h-screen flex-col bg-background font-sans">
    <Header />
    <main class="flex-1">
      <Hero />
      <CaseTable page={1} />
      <Separator />
      <HomeGuide />
      <Separator />
      <Attorneys />
      <Separator />
      <Location />
    </main>
    <Footer />
  </div>
  <BottomBar />
  <Reveal />
</BaseLayout>
