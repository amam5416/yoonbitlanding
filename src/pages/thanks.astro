---
/** 상담 신청 완료 페이지 — 접수 성공 후 이동. ?case= 로 사건명 표시 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Icons from '@/components/Icons.astro';
import { SITE } from '@/site.config';

const next = [
  { icon: 'file-text', title: '접수 내용 확인', desc: '담당자가 접수 내용을 확인하고 사건 자료를 검토합니다.' },
  { icon: 'phone', title: '담당 변호사 연락', desc: '입력하신 연락처로 전화드립니다. 모르는 번호도 받아 주세요.' },
  { icon: 'snowflake', title: '추적·동결 착수', desc: '상담 후 자금 추적과 계좌 동결 절차를 바로 시작합니다.' },
] as const;
---
<BaseLayout title={`상담 신청 완료 | ${SITE.name}`} description="상담 신청이 접수되었습니다. 담당자가 확인 후 연락드립니다." noindex>
  <div class="flex min-h-screen flex-col bg-background">
    <Header />
    <main class="flex-1">
      <section class="relative overflow-hidden border-b border-border marble-section" aria-labelledby="thanks-title">
        <div class="pointer-events-none absolute inset-0 bg-brand-glow" aria-hidden="true"></div>
        <div class="relative mx-auto flex w-full max-w-3xl flex-col items-center px-4 py-16 text-center sm:px-6 sm:py-24">
          <span class="flex h-20 w-20 items-center justify-center rounded-full border border-success-soft/40 bg-success-soft/15 text-success shadow-[0_0_40px_-10px_rgba(63,180,106,0.6)]">
            <Icons name="check" class="h-10 w-10" />
          </span>
          <p class="mt-6 text-xs font-bold uppercase tracking-[0.25em] text-success">접수 완료</p>
          <h1 id="thanks-title" class="mt-3 text-2xl font-bold tracking-tight text-foreground sm:text-4xl">상담 신청이 접수되었습니다</h1>
          <p id="thanks-case" class="mt-3 hidden rounded-full border border-primary/30 bg-primary/10 px-4 py-1.5 text-sm font-semibold text-gold"></p>
          <p class="mt-4 max-w-xl text-pretty text-sm leading-relaxed text-muted-foreground sm:text-base">
            담당자가 내용을 확인한 뒤 입력하신 번호로 연락드립니다.<br class="sm:hidden" /> 그동안 추가 송금은 하지 마시고, 대화방과 입금 내역은 그대로 보관해 주세요.
          </p>
          <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row">
            <a href={SITE.phoneHref} class="inline-flex h-12 items-center justify-center gap-2 rounded-lg btn-gold px-6 text-base font-bold"><Icons name="phone" class="h-5 w-5" />급하면 지금 전화 {SITE.phone}</a>
            <a href="/" class="inline-flex h-12 items-center justify-center gap-1.5 rounded-lg border border-border glass-input px-6 text-sm font-semibold text-foreground transition-colors hover:border-primary hover:text-primary"><Icons name="arrow-left" class="h-4 w-4" />홈으로</a>
          </div>
        </div>
      </section>

      <section class="mx-auto w-full max-w-4xl px-4 py-12 sm:px-6" aria-labelledby="next-title">
        <h2 id="next-title" class="text-lg font-bold text-foreground">이제 이렇게 진행됩니다</h2>
        <ol class="mt-5 grid gap-4 sm:grid-cols-3">
          {next.map((n, i) => (
            <li class="card-lux rounded-xl p-5">
              <div class="flex items-center gap-3">
                <span class="flex h-9 w-9 items-center justify-center rounded-md bg-primary/10 text-primary"><Icons name={n.icon} class="h-4 w-4" /></span>
                <span class="text-xs font-bold text-primary">STEP {i + 1}</span>
              </div>
              <h3 class="mt-3 text-sm font-bold text-foreground">{n.title}</h3>
              <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">{n.desc}</p>
            </li>
          ))}
        </ol>
      </section>
    </main>
    <Footer />
  </div>
</BaseLayout>

<script>
  // ?case=사건명 이 있으면 표시
  const c = new URLSearchParams(location.search).get('case');
  const el = document.getElementById('thanks-case');
  if (c && el) { el.textContent = `${c} 피해 접수`; el.classList.remove('hidden'); }
</script>
